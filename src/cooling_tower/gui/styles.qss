    font-size: 8pt;
    font-weight: 650;
}

QPushButton#preparationStepSelector[active="true"] QLabel#preparationStepProgressLabel {
    color: #52697a;
}

QWidget#preparationStepPage[stepTone="source"],
QWidget#preparationStepPage[stepTone="slicer"] {
    background: transparent;
    border: none;
}

QWidget#preparationTransitionViewport {
    background: #f1f6f9;
    border: none;
}

QLabel#preparationTransitionOverlay {
    background: transparent;
    border: none;
}

QWidget#preparationStepShell,
QWidget#preparationStepCopy {
    background: transparent;
    border: none;
}

QFrame#preparationStepIntro {
    background: transparent;
    border: none;
}

QLabel#preparationStepEyebrow {
    color: #1769aa;
    background: #e7f1f8;
    border: 1px solid #bfd7e8;
    border-radius: 9px;
    padding: 3px 8px;
    font-size: 8.5pt;
    font-weight: 750;
}

QWidget#preparationStepShell[stepTone="slicer"] QLabel#preparationStepEyebrow {
    color: #1769aa;
    background: #e7f1f8;
    border-color: #bfd7e8;
}

QLabel#preparationStepHeading {
    color: #183a59;
    font-size: 14pt;
