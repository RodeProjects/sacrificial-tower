}

QLabel#preparationStepDescription {
    color: #607386;
    font-size: 9.5pt;
}

QLabel#preparationStepState {
    color: #566b7e;
    background: #eef3f6;
    border: 1px solid #d4dee6;
    border-radius: 10px;
    padding: 4px 10px;
    font-size: 9pt;
    font-weight: 600;
}

QLabel#preparationStepState[state="active"] {
    color: #155f98;
    background: #eaf4fb;
    border-color: #a9cce5;
}

QWidget#preparationStepShell[stepTone="slicer"] QLabel#preparationStepState[state="active"] {
    color: #155f98;
    background: #eaf4fb;
    border-color: #a9cce5;
}

QLabel#preparationStepState[state="success"] {
    color: #176b45;
    background: #eaf7f0;
    border-color: #a5d0b8;
}

QLabel#preparationStepState[state="error"] {
    color: #9c2b22;
    background: #fff1ef;
    border-color: #edb6b0;
}

QLabel#preparationStepState[state="locked"] {
    color: #687781;
    background: #edf1f3;
    border-color: #c5cfd5;
}

QFrame#sectionCard[embeddedStep="true"][stepTone="source"] {
    background: #ffffff;
    border: 1px solid #c4d6e2;
    border-radius: 10px;
}

QFrame#sectionCard[embeddedStep="true"][stepTone="slicer"] {
    background: #ffffff;
    border: 1px solid #c4d6e2;
    border-radius: 10px;
}

QFrame#sectionCard[embeddedStep="true"] > QFrame#sectionCardHeader,
QFrame#sectionCard[embeddedStep="true"] > QFrame#sectionCardBodyDivider {
    background: transparent;
    border: none;
    min-height: 0;
    max-height: 0;
}

QFrame#sectionCard[embeddedStep="true"][stepTone="source"] > QFrame#sectionCardBody {
    background: #ffffff;
    border: none;
    border-radius: 10px;
}

QFrame#sectionCard[embeddedStep="true"][stepTone="slicer"] > QFrame#sectionCardBody {
