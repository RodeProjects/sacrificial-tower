    font-weight: 650;
    border-radius: 4px;
    padding: 5px;
}
QLabel#predictionValue[state="warning"] {
    color: #9a5208;
    background: #fff3d8;
    border-radius: 4px;
    padding: 5px;
}
QLabel#predictionValue[state="error"] {
    color: #b42318;
    background: #fff1f0;
    border-radius: 4px;
    padding: 5px;
}

QFrame#predictionPreviewDivider {
