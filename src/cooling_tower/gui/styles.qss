    font-size: 12pt;
    font-weight: 700;
}

QPushButton#preparationStepSelector[stepTone="slicer"] QLabel#preparationStepSelectorTitle {
    color: #40576a;
}

QPushButton#preparationStepSelector[active="true"] QLabel#preparationStepSelectorTitle,
QPushButton#preparationStepSelector[stepTone="slicer"][active="true"] QLabel#preparationStepSelectorTitle {
    color: #40576a;
}

QLabel#preparationStepSelectorIcon {
    color: #176b45;
    background: transparent;
    font-size: 11pt;
    font-weight: 800;
}

QLabel#preparationStepProgressLabel {
    color: #52697a;
