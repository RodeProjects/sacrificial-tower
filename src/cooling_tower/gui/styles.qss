    padding: 2px 0 4px 0;
}

QToolButton#stlInfoButton,
QToolButton#settingInfoButton {
    color: #1769aa;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f3f9fd, stop: 1 #deedf8);
    border: 1px solid #b6d4e9;
    border-radius: 16px;
    padding: 0;
    font-size: 13pt;
    font-weight: 700;
}
QToolButton#settingInfoButton {
    border-radius: 10px;
    font-size: 8pt;
}
QToolButton#stlInfoButton:hover,
QToolButton#settingInfoButton:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e8f4fc, stop: 1 #cce5f5);
    border-color: #80b4d7;
}
QToolButton#stlInfoButton:pressed,
QToolButton#settingInfoButton:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #c1deef, stop: 1 #e5f2fa);
}

QToolButton#optionsButton {
    color: #1769aa;
    background: #eaf4fb;
    border: 1px solid #b6d4e9;
    border-radius: 16px;
    padding: 0;
}
QToolButton#optionsButton:hover { background: #dceefa; border-color: #80b4d7; }
QToolButton#optionsButton:pressed { background: #cbe4f4; }
QToolButton#optionsButton::menu-indicator { image: none; }
QToolButton#optionsButton[invalid="true"] {
    color: #b42318;
    background: #fff1f0;
    border-color: #ef8f87;
}

QMenu#mainOptionsMenu {
    background: #ffffff;
    border: 1px solid #b6c9d8;
    border-radius: 8px;
    padding: 6px;
}

QMenu#mainOptionsMenu::item {
    color: #21384f;
    padding: 9px 30px 9px 10px;
    border-radius: 6px;
}

QMenu#mainOptionsMenu::item:selected {
    color: #105b93;
    background: #eaf4fb;
}

QMenu#mainOptionsMenu::icon { padding-left: 3px; }

QDialog#additionalOptionsDialog {
    background: #f5f8fb;
}

QDialog#aboutDialog,
QDialog#exportSuccessDialog,
QScrollArea#aboutScroll,
QWidget#aboutContent {
    background: #f5f8fb;
}

QLabel#exportSuccessTitle {
    color: #176b45;
    font-size: 15pt;
    font-weight: 700;
}

QLabel#exportSuccessSummary,
QLabel#exportSuccessMetric {
    color: #29465f;
    font-size: 10pt;
}

QFrame#exportSuccessMetrics {
    background: #ffffff;
    border: 1px solid #d6e0e8;
    border-radius: 8px;
}

QFrame#exportSuccessUsage {
    background: #ffffff;
    border: 1px solid #d6e0e8;
    border-radius: 8px;
}

QLabel#exportSuccessUsageTitle {
    color: #29465f;
    font-size: 10pt;
    font-weight: 700;
}

QLabel#exportSuccessUsageText {
    color: #40566b;
    font-size: 9.6pt;
}

QLabel#exportSuccessTolerance {
    background: transparent;
    border: none;
    font-weight: 650;
}

QLabel#exportSuccessTolerance[status="within"] { color: #176b45; }
QLabel#exportSuccessTolerance[status="outside"] { color: #9b6411; }
QLabel#exportSuccessTolerance[status="unknown"] { color: #526274; }

QLabel#exportSuccessCheckHint {
    color: #526274;
    background: #edf6fc;
    border: 1px solid #c5dce9;
    border-radius: 6px;
    padding: 12px 14px;
}

QLabel#exportSuccessError {
    color: #b42318;
    background: #fff1f0;
    border: 1px solid #e3a19c;
    border-radius: 6px;
    padding: 7px 9px;
}

QDialog#supportReportDialog {
    background: #f5f8fb;
}

QLabel#supportReportTitle {
    color: #123c63;
    font-size: 15pt;
    font-weight: 700;
}

QLabel#supportReportIntroduction,
QLabel#supportReportPrivacyText {
    color: #405b73;
}

QTextEdit#supportReportDescription {
    min-height: 105px;
}

QFrame#supportReportPrivacy {
    background: #edf6fc;
    border: 1px solid #b6d4e9;
    border-radius: 8px;
}

QLabel#supportReportResult {
    color: #526274;
    background: transparent;
    border: none;
    padding: 3px 1px;
}

QLabel#supportReportResult[state="success"] {
    color: #17633a;
}

QLabel#supportReportResult[state="error"] {
    color: #9b1c1c;
}

QFrame#aboutHero {
    background: #eaf4fb;
    border: 1px solid #b6d4e9;
    border-radius: 12px;
}

QLabel#aboutProductTitle {
    color: #123c63;
    font-size: 17pt;
    font-weight: 700;
}

QLabel#aboutProductDescription {
    color: #405b73;
    font-size: 10.5pt;
}

QLabel#aboutVersion {
    color: #1769aa;
    font-weight: 650;
}

QFrame#aboutSection {
    background: #ffffff;
    border: 1px solid #cfdae3;
    border-radius: 10px;
}

QLabel#aboutSectionTitle {
    color: #123c63;
    font-size: 11.5pt;
    font-weight: 700;
}

QLabel#aboutEmphasis {
    color: #21384f;
    font-size: 11pt;
    font-weight: 650;
}

QLabel#aboutMetaText,
QLabel#aboutBodyText {
    color: #405b73;
}

QLabel#aboutCopyrightSymbol {
    color: #1769aa;
}

QLabel#aboutStatusBadge {
    border-radius: 9px;
    padding: 4px 9px;
    font-weight: 650;
}

QLabel#aboutStatusBadge[licenseStatus="development"] {
    color: #6b4b00;
    background: #fff3ce;
    border: 1px solid #e3c365;
}

QLabel#aboutStatusBadge[licenseStatus="evaluation"] {
    color: #174ea6;
    background: #eaf2ff;
    border: 1px solid #9bbcf2;
}

QLabel#aboutStatusBadge[licenseStatus="licensed"] {
    color: #17633a;
    background: #e7f6ed;
    border: 1px solid #8fc9a5;
}

QLabel#aboutStatusBadge[licenseStatus="unlicensed"] {
    color: #9b1c1c;
    background: #fdecec;
    border: 1px solid #e4a1a1;
}

QPushButton#aboutLegalButton {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #ffffff, stop: 1 #f0f5f9);
    border-color: #b6c9d8;
    text-align: left;
    padding-right: 32px;
}

QLabel#disclosureChevron {
    color: #405266;
    background: transparent;
    font-size: 13pt;
    font-weight: 700;
}

QPushButton#aboutLegalButton:hover {
    color: #105b93;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f4f9fd, stop: 1 #dfedf8);
    border-color: #80b4d7;
}

QPushButton#aboutLegalButton:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #d4e8f5, stop: 1 #f0f7fc);
}

QFrame#aboutSupport {
    background: #edf6fc;
    border: 1px solid #b6d4e9;
    border-radius: 8px;
}

QLabel#aboutSupportLink { color: #123c63; }

QLabel#aboutPlaceholder {
    color: #405b73;
    background: #ffffff;
    border: 1px solid #cfdae3;
    border-radius: 7px;
    padding: 8px 10px;
}

QPushButton#aboutCloseButton { padding-left: 15px; padding-right: 15px; }

QLabel#dialogTitle {
    color: #123c63;
    font-size: 15pt;
    font-weight: 700;
}

/* ---------- STL-Datei ---------- */
QFrame#sourceDropZone {
    background: #f6fafd;
    border: 2px dashed #2f6690;
    border-radius: 10px;
    /* 180 px Inhaltsminimum + Rahmen ergeben dieselben 184 px wie die
       frühere leere Darstellung mit den inzwischen ausgeblendeten Zeilen. */
    min-height: 256px;
}

QFrame#sourceDropZone[loaded="true"] {
    min-height: 96px;
    background: #f6fafd;
    border: 2px dashed #2f6690;
}

QFrame#sourceDropZone[completed="true"] {
    background: #f6fafd;
    border-color: #2f6690;
}

/* This interaction state must win over every persistent loaded/completed
   state so the drop target always reacts throughout the workflow. */
QFrame#sourceDropZone[dragActive="true"] {
    background: #deeff8;
    border-color: #15527f;
    border-style: solid;
}

/* The completed source page has a more specific persistent selector above.
   Repeat that specificity for drag hover so both frame and fill change. */
QWidget#preparationStepPage[stepTone="source"]
QFrame#sourceDropZone[dragActive="true"] {
    background: #deeff8;
    border-color: #15527f;
    border-style: solid;
}

QFrame#sourceDropZone QLabel[replacementHint="true"] {
    color: #6f7d89;
    font-style: italic;
    font-size: 9.3pt;
    padding: 3px 0 5px 0;
}

QWidget#stlValidationFeedback,
QWidget#stlNoticeHeading {
    background: transparent;
    border: none;
}

QLabel#stlValidationMessage,
QLabel#stlValidationWarningMessage {
    background: transparent;
    border: none;
    color: #506371;
    font-size: 9pt;
    font-weight: 400;
    padding: 0;
}

QLabel#stlFeedbackTitle {
    background: transparent;
    border: none;
    font-size: 9pt;
    font-weight: 600;
    text-decoration: underline;
    padding: 0;
}

QLabel#stlFeedbackIcon {
    background: transparent;
    border: none;
    font-size: 11pt;
    font-weight: 600;
    padding: 0;
}

QLabel#stlFeedbackTitle[severity="success"],
QLabel#stlFeedbackIcon[severity="success"] {
    color: #176b45;
}

QLabel#stlFeedbackTitle[severity="warning"],
QLabel#stlFeedbackIcon[severity="warning"] {
    color: #9b6411;
}

QLabel#stlFeedbackTitle[severity="error"],
QLabel#stlFeedbackIcon[severity="error"] {
    color: #b42318;
}

QLabel#sourceInfoCaption {
    color: #647586;
    font-weight: 600;
    min-width: 82px;
}

QLabel#sourceFilePath { color: #43576a; }
QLabel#dropFileName { font-weight: 650; color: #21384f; }

QWidget#sourceGuideRow {
    background: transparent;
    border: none;
}

QLabel#sourceGuide {
    color: #405b73;
    background: transparent;
    border: none;
    padding: 0;
}

QLabel#sourceGuideIcon {
    color: #1769aa;
    background: transparent;
    border: none;
    font-size: 15pt;
    font-weight: 700;
}

QPushButton#reconstructedConfigToggle {
    text-align: left;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #ffffff, stop: 1 #eef3f8);
    border-color: #d6dee8;
}

QPushButton[compactDisclosure="true"] {
    color: #5d7285;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(255, 255, 255, 35), stop: 1 rgba(230, 240, 247, 20));
    border: none;
    border-radius: 5px;
    padding: 3px 6px;
    min-height: 20px;
    text-align: right;
    font-size: 9pt;
    font-weight: 500;
}

QPushButton[compactDisclosure="true"]:hover {
    color: #155f98;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f6fafc, stop: 1 #e5eff5);
    border: none;
}

QPushButton[compactDisclosure="true"]:checked,
QPushButton[compactDisclosure="true"]:pressed,
QPushButton[compactDisclosure="true"]:focus {
    color: #5d7285;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(255, 255, 255, 35), stop: 1 rgba(230, 240, 247, 20));
    border: none;
    outline: none;
}

QPushButton#stlValidationDetailsToggle,
QPushButton#stlValidationDetailsToggle:checked,
QPushButton#stlValidationDetailsToggle:pressed,
QPushButton#stlValidationDetailsToggle:focus {
    color: #7b858d;
}

QPushButton#stlValidationDetailsToggle:hover {
    color: #5e6c77;
}

QScrollArea#slicerAnalysisDetails,
QScrollArea#slicerAnalysisDetails QWidget#qt_scrollarea_viewport,
QWidget#slicerAnalysisDetailsContent {
    color: #1f2f3d;
    background: #f5f7f9;
}

QScrollArea#slicerAnalysisDetails {
    border: 1px solid #b8c5d1;
    border-radius: 6px;
}

QScrollArea#slicerAnalysisDetails QLabel {
    color: #1f2f3d;
    background: #f5f7f9;
    border: none;
    padding: 0;
}

QTextEdit#stlValidationDetails,
QScrollArea#slicerAnalysisDetails QTextEdit#profileDiagnostics,
QScrollArea#slicerAnalysisDetails QTextEdit#reconstructedConfigText {
    color: #1f2f3d;
    background: #f5f7f9;
    border: 1px solid #d7e0e7;
}

QTextEdit#reconstructedConfigText, QTextEdit#profileDiagnostics {
    font-family: Consolas, "Cascadia Mono", monospace;
    font-size: 9pt;
    background: #f8fafc;
}

/* ---------- Eingaben ---------- */
QLineEdit, QTextEdit, QComboBox, QDoubleSpinBox, QSpinBox {
    background: #ffffff;
    border: 1px solid #b8c5d1;
    border-radius: 6px;
    min-height: 34px;
}

QLineEdit, QTextEdit, QComboBox { padding: 4px 8px; }

QComboBox[important="true"] {
    color: #155f98;
    background: #edf6fd;
    border-color: #9fc7e5;
    font-weight: 600;
}

QComboBox[important="true"]:hover,
QComboBox[important="true"][hovered="true"] {
    color: #0f568f;
    background: #e3f1fb;
}

QComboBox[important="true"]:focus {
    color: #0f568f;
    background: #e3f1fb;
    border-color: #70a9d2;
}

QDoubleSpinBox, QSpinBox {
    /* The spin controls already reserve their own 24 px arrow column.
       Only the uniform 44 px unit overlay plus a 4 px gap is needed here. */
    padding: 0 48px 0 8px;
}

/* The range tool uses native suffixes, without the main window's unit overlay. */
QDialog#layerRangeDialog QDoubleSpinBox,
QDialog#layerRangeDialog QSpinBox { padding: 0 8px; }

QDoubleSpinBox#manualBaseWidth[automaticPreview="true"] {
    color: #667684;
    background: #f1f4f6;
    border-color: #d6dee4;
}

QDoubleSpinBox#manualBaseWidth[automaticPreview="true"]::up-button,
QDoubleSpinBox#manualBaseWidth[automaticPreview="true"]::down-button {
    background: #edf1f4;
    border-color: #d6dee4;
}

QLabel#numericEditorUnit {
    color: #7a8794;
    background: transparent;
    border: none;
    padding: 0 4px 0 0;
    font-size: 9pt;
    font-weight: 500;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    background: transparent;
    border: none;
    border-left: 1px solid #b8c5d1;
    margin: 1px 1px 1px 0;
    width: 28px;
}

QComboBox::down-arrow {
    image: url(__COMBO_DOWN_ICON__);
    width: 10px;
    height: 7px;
}

QLineEdit:hover, QTextEdit:hover,
QDoubleSpinBox:hover, QSpinBox:hover {
    background: #fbfdff;
    border-color: #7f9bb2;
}

QComboBox:hover,
QComboBox[hovered="true"] {
    background: #fbfdff;
}

QComboBox:hover::drop-down,
QComboBox[hovered="true"]::drop-down {
    background: #eaf1f7;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
}

QComboBox QAbstractItemView {
    color: #21384f;
    background: #ffffff;
    border: 1px solid #9fb5c7;
    border-radius: 6px;
    outline: 0;
    selection-color: #123f63;
    selection-background-color: #e5f1fa;
}

QComboBox QAbstractItemView:hover {
    background: #fbfdff;
}

QComboBox QAbstractItemView::item {
    background: #ffffff;
    border: none;
    padding: 5px 8px;
}

QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:selected {
    color: #123f63;
    background: #e5f1fa;
}

QDoubleSpinBox::up-button, QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #c7d1da;
    border-bottom: 1px solid #dfe5ea;
    border-top-right-radius: 5px;
}

QDoubleSpinBox::up-arrow, QSpinBox::up-arrow {
    image: url("__SPIN_UP_ICON__");
    width: 10px;
    height: 7px;
}

QDoubleSpinBox::down-button, QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 24px;
    border-left: 1px solid #c7d1da;
    border-top: 1px solid #dfe5ea;
    border-bottom-right-radius: 5px;
}

QDoubleSpinBox::down-arrow, QSpinBox::down-arrow {
    image: url("__SPIN_DOWN_ICON__");
    width: 10px;
    height: 7px;
}

QDoubleSpinBox::up-button:hover, QSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover, QSpinBox::down-button:hover {
    background: #eaf1f7;
}

QDoubleSpinBox[invalid="true"], QSpinBox[invalid="true"],
QLineEdit[invalid="true"], QTextEdit[invalid="true"],
QComboBox[invalid="true"] {
    border: 2px solid #c43d3d;
    background: #fff4f3;
}

QDoubleSpinBox[warning="true"], QSpinBox[warning="true"],
QLineEdit[warning="true"], QComboBox[warning="true"] {
    border: 2px solid #d38a14;
    background: #fff9ea;
}

/* Critical validation always wins when both states apply. */
QDoubleSpinBox[warning="true"][invalid="true"],
QSpinBox[warning="true"][invalid="true"],
QLineEdit[warning="true"][invalid="true"],
QComboBox[warning="true"][invalid="true"] {
    border: 2px solid #c43d3d;
    background: #fff4f3;
}

QLineEdit:focus, QDoubleSpinBox:focus, QSpinBox:focus,
QComboBox:focus, QPushButton:focus {
    border: 2px solid #3b82f6;
}

/* Validation severity must remain visible while the user edits the field. */
QDoubleSpinBox[warning="true"]:focus, QSpinBox[warning="true"]:focus,
QLineEdit[warning="true"]:focus, QComboBox[warning="true"]:focus {
    border: 2px solid #d38a14;
    background: #fff9ea;
}

QDoubleSpinBox[invalid="true"]:focus, QSpinBox[invalid="true"]:focus,
QLineEdit[invalid="true"]:focus, QTextEdit[invalid="true"]:focus,
QComboBox[invalid="true"]:focus,
QDoubleSpinBox[warning="true"][invalid="true"]:focus,
QSpinBox[warning="true"][invalid="true"]:focus,
QLineEdit[warning="true"][invalid="true"]:focus,
QComboBox[warning="true"][invalid="true"]:focus {
    border: 2px solid #c43d3d;
    background: #fff4f3;
}

/* The Windows Qt style does not reliably repaint QComboBox:hover.  The
   WheelSafeComboBox therefore exposes an explicit state; keeping this final
   rule after the generic input states makes the visible feedback deterministic. */
QComboBox[important="true"][hovered="true"] {
    color: #0b4f82;
    background: #d8ebf8;
}

QComboBox[important="true"][hovered="true"]::drop-down {
    background: #c7e1f2;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    margin: 1px 1px 1px 0;
}

/* ---------- Schaltflächen ---------- */
QPushButton {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #fafcfd,
        stop: 1 #e8eef3
    );
    border: 1px solid #bdcad5;
    border-radius: 7px;
    padding: 7px 13px;
    min-height: 34px;
    color: #21384f;
}

QPushButton:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f1f6fa,
        stop: 1 #dce7f0
    );
    border-color: #92a9bd;
}
QPushButton:pressed {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #dce6ee,
        stop: 1 #cfdce6
    );
}
QPushButton:disabled {
    color: #8995a0;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f5f7f8, stop: 1 #e7ecef);
    border-color: #d8dee3;
}

QPushButton#sourcePrimaryActionButton,
QPushButton#layerRangeApplyButton,
QPushButton#profileConfirmButton {
    color: #28563d;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e7f8ed, stop: 1 #c7e9d3);
    border-color: #a6cbb4;
    font-size: 10pt;
    font-weight: 650;
}

QPushButton#profileConfirmButton[confirmed="true"] {
    color: #176b45;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f3fbf6, stop: 1 #e1f3e8);
    border-color: #92c9ad;
}

QPushButton#sourcePrimaryActionButton:hover,
QPushButton#layerRangeApplyButton:hover,
QPushButton#profileConfirmButton:hover {
    color: #214b35;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #effbf3, stop: 1 #d3efdc);
    border-color: #86b798;
}

QPushButton#profileConfirmButton:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #bddfc9, stop: 1 #e2f6e9);
}

QPushButton#sourcePrimaryActionButton {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e7f8ed, stop: 1 #c7e9d3);
}
QPushButton#sourcePrimaryActionButton:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #effbf3, stop: 1 #d3efdc);
}
QPushButton#sourcePrimaryActionButton:pressed,
QPushButton#layerRangeApplyButton:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #bddfc9, stop: 1 #e2f6e9);
}

QPushButton#sourcePrimaryActionButton:disabled,
QPushButton#layerRangeApplyButton:disabled,
QPushButton#profileConfirmButton:disabled {
    color: #7994aa;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f6f9fa, stop: 1 #e7edf1);
    border-color: #d3dde5;
}

QPushButton#headerResetButton,
QPushButton#towerResetButton,
QPushButton#layerRangeToolButton {
    min-height: 30px;
    max-height: 30px;
    padding: 0 12px;
}
QPushButton#headerResetButton:disabled,
QPushButton#towerResetButton:disabled {
    color: #8995a0;
    background: #edf0f2;
    border-color: #d8dee3;
}

QToolButton:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f3f8fb, stop: 1 #e1edf5);
    border-color: #92a9bd;
}

QCheckBox:hover {
    color: #0f5d91;
    background: #f1f7fb;
    border-radius: 5px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background: #ffffff;
    border: 1px solid #71879a;
    border-radius: 3px;
}

QCheckBox::indicator:hover {
    background: #ffffff;
    border-color: #1769aa;
}
QCheckBox::indicator:pressed {
    background: #eef5fa;
    border-color: #105784;
}
QCheckBox::indicator:checked {
    image: url("__CHECKBOX_CHECK_ICON__");
    background: #1769aa;
    border-color: #105784;
}
QCheckBox::indicator:checked:hover {
    background: #105b93;
    border-color: #0d4c7e;
}

QCheckBox#simulateFullTowerInfill,
QCheckBox#simulateFullTowerInfill:hover,
QCheckBox#simulateFullTowerInfill:pressed,
QCheckBox#simulateTowerWithoutSupports,
QCheckBox#simulateTowerWithoutSupports:hover,
QCheckBox#simulateTowerWithoutSupports:pressed,
QCheckBox#showSettingLimits,
QCheckBox#showSettingLimits:hover,
QCheckBox#showSettingLimits:pressed {
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 4px 7px 4px 0;
}
QCheckBox#simulateFullTowerInfill:hover,
QCheckBox#simulateTowerWithoutSupports:hover,
QCheckBox#showSettingLimits:hover {
    color: #0f5d91;
    background: #f1f7fb;
}
QCheckBox#simulateFullTowerInfill::indicator,
QCheckBox#simulateTowerWithoutSupports::indicator,
QCheckBox#showSettingLimits::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox#showAllProfilesCheckBox,
QCheckBox#showAllProfilesCheckBox:hover,
QCheckBox#showAllProfilesCheckBox:pressed {
    color: #21384f;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 3px 6px;
}
QCheckBox#showAllProfilesCheckBox:hover {
    color: #0f5d91;
    background: #e5f0f8;
}
QCheckBox#showAllProfilesCheckBox:pressed {
    color: #0f5d91;
    background: #d8e8f3;
}
QCheckBox#showAllProfilesCheckBox::indicator {
    width: 16px;
    height: 16px;
    background: #ffffff;
    border: 1px solid #71879a;
    border-radius: 3px;
}
QCheckBox#showAllProfilesCheckBox::indicator:hover {
    background: #ffffff;
    border-color: #1769aa;
}
QCheckBox#showAllProfilesCheckBox::indicator:pressed {
    background: #eef5fa;
    border-color: #105784;
}
QCheckBox#showAllProfilesCheckBox::indicator:checked {
    image: url("__CHECKBOX_CHECK_ICON__");
    background: #1769aa;
    border-color: #105784;
}
QCheckBox#showAllProfilesCheckBox::indicator:checked:hover {
    background: #105b93;
    border-color: #0d4c7e;
}
QCheckBox#showAllProfilesCheckBox::indicator:checked:pressed {
    background: #0d4c7e;
    border-color: #093c64;
}

QCheckBox#automaticBaseWidth,
QCheckBox#automaticBaseWidth:hover {
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 4px 7px 4px 0;
}

QCheckBox#automaticBaseWidth::indicator {
    width: 16px;
    height: 16px;
}

QPushButton#primaryButton {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #2f7fb7, stop: 1 #1769aa);
    border-color: #105784;
    color: #ffffff;
    font-weight: 650;
    padding: 7px 25px;
}

QPushButton#primaryButton:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #3b8bc1, stop: 1 #1d75b7);
}
QPushButton#primaryButton:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #105b93, stop: 1 #2a75aa);
}
QPushButton#primaryButton:disabled {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #b9cbd8, stop: 1 #91abc0);
    border-color: #91aabd;
}

QPushButton#exportButton {
    padding: 7px 25px;
}

QPushButton#generationExportButton {
    padding: 7px 25px;
}

QPushButton#previewButton {
    color: #ffffff;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #2f7fb7,
        stop: 1 #1769aa
    );
    border-color: #145b91;
    font-weight: 650;
}

QPushButton#previewButton:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #3b8bc1,
        stop: 1 #1d75b7
    );
    border-color: #104e7d;
}

QFrame#previewActionControl {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #2f7fb7,
        stop: 1 #1769aa
    );
    border: 1px solid #145b91;
    border-radius: 7px;
}

QFrame#previewActionControl QPushButton#previewButton {
    color: #ffffff;
    background: transparent;
    border: none;
    border-radius: 6px;
}

QFrame#previewActionControl QPushButton#previewButton:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #3b8bc1,
        stop: 1 #1d75b7
    );
}

QFrame#previewActionControl QPushButton#previewButton:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #0d4d7d, stop: 1 #246fa5);
}

QFrame#previewActionControl QPushButton#previewButton:disabled {
    color: #ffffff;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #b9cbd8, stop: 1 #91abc0);
}

QPushButton#settingResetButton {
    padding: 0;
    min-width: 34px;
    max-width: 40px;
    font-size: 13pt;
    color: #52677a;
    background: #f5f8fb;
    border: 1px solid #bdcad5;
    border-radius: 7px;
}

QPushButton#settingResetButton:hover {
    color: #1769aa;
    background: #eaf4fb;
    border-color: #8db9d8;
}

QPushButton#settingResetButton:pressed {
    color: #0f568c;
    background: #d8e9f5;
    border-color: #609ac1;
}

/* Tastaturfokus bleibt für die Bedienbarkeit erhalten, erzeugt nach einem
   Mausklick aber keine dauerhaft blaue Auswahlbox. */
QPushButton#settingResetButton:focus {
    color: #52677a;
    background: #f5f8fb;
    border: 1px solid #bdcad5;
}

QPushButton#settingResetButton[modified="true"] {
    color: #1769aa;
    background: #eef7fd;
    border-color: #a9cce3;
}

QPushButton#settingResetButton[modified="true"]:hover {
    background: #dfeffa;
    border-color: #78acd0;
}

QPushButton#settingResetButton[modified="true"]:focus {
    color: #1769aa;
    background: #eef7fd;
    border: 1px solid #a9cce3;
}

QPushButton#settingResetButton:disabled,
QPushButton#settingResetButton[modified="false"] {
    color: #98a3ad;
    background: #edf0f2;
    border-color: #d8dee3;
}

/* ---------- Status, Hinweise und Fehler ---------- */
QLabel#errorLabel {
    color: #152536;
    font-size: 9.3pt;
    padding: 4px 0;
}

QFrame#issuePanel {
    border-radius: 8px;
}

QFrame#issuePanel[severity="error"] {
    background: #fff1f0;
    border: 1px solid #e3aaa5;
    border-left: 4px solid #b42318;
}

QFrame#issuePanel[severity="warning"] {
    background: #fff7e6;
    border: 1px solid #ebca88;
    border-left: 4px solid #d38a14;
}

QFrame#issuePanel[severity="info"] {
    background: #eef6fc;
    border: 1px solid #b9d5e8;
    border-left: 4px solid #1769aa;
}

QPushButton#footerNoticeHeader {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(255, 255, 255, 30), stop: 1 rgba(255, 255, 255, 8));
    border: none;
    border-radius: 7px;
    color: #21384f;
    font-weight: 700;
    min-height: 32px;
    padding: 2px 8px;
    text-align: left;
}

QFrame#footerNoticeHeaderRow {
    background: transparent;
    border: none;
}

QToolButton#footerNoticeChevron {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(255, 255, 255, 30), stop: 1 rgba(255, 255, 255, 8));
    border: none;
    border-radius: 7px;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    padding: 0;
}

QPushButton#footerNoticeHeader:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(255, 255, 255, 145), stop: 1 rgba(255, 255, 255, 75));
}

QToolButton#footerNoticeChevron:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(255, 255, 255, 145), stop: 1 rgba(255, 255, 255, 75));
}

QLabel#numericRangeHint {
    color: #718096;
    background: transparent;
    border: none;
    padding: 0 2px;
    font-size: 8pt;
}

QFrame#footerNoticeBody {
    background: transparent;
    border: none;
    border-top: 1px solid rgba(82, 98, 116, 45);
}

QLabel#issueTitle { font-weight: 700; color: #21384f; }

QScrollArea#inlineHintScroll,
QScrollArea#inlineHintScroll > QWidget > QWidget {
    background: transparent;
    border: none;
}

QLabel#settingMessage {
    color: #617181;
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 4px 6px;
    font-size: 9.5pt;
}
QLabel#settingMessage[error="true"] {
    color: #a52b22;
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 4px 6px;
}

QLabel#settingMessage[warning="true"] {
    color: #8a4b08;
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 4px 6px;
}

QLabel#settingMessageDetails {
    color: #526274;
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 4px 6px;
}

QToolButton#settingMessageExpand {
    color: #526274;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #fafcfd, stop: 1 #eaf0f5);
    border: 1px solid #d6dee8;
    border-radius: 4px;
    min-height: 18px;
    padding: 0;
    text-align: center;
}

QToolButton#settingMessageExpand:hover {
    color: #1769aa;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f2f8fb, stop: 1 #e0edf5);
}

QCheckBox[invalid="true"] {
    color: #b42318;
    background: #fff1f0;
    border: 1px solid #c43d3d;
    border-radius: 5px;
    padding: 5px;
}

QLabel#towerNeedLabel[state="pending"],
QLabel#towerNeedLabel[state="analyzing"] { color: #526274; }
QLabel#towerNeedLabel {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 4px 6px;
    font-size: 9.5pt;
}
QLabel#towerNeedLabel[state="required"] { color: #176b45; }
QLabel#towerNeedLabel[state="notRequired"] {
    color: #176b45;
    background: transparent;
}
QLabel#towerNeedLabel[state="error"] {
    color: #b42318;
    background: transparent;
}

QLabel#slicerStatusLabel[state="pending"],
QLabel#slicerStatusLabel[state="analyzing"] { color: #526274; }
QLabel#slicerStatusLabel[state="availableRecommended"],
QLabel#slicerStatusLabel[state="available"],
QLabel#profileStatusLabel[state="availableRecommended"],
QLabel#profileStatusLabel[state="available"] { color: #176b45; }
QLabel#slicerStatusLabel[state="manual"],
QLabel#slicerStatusLabel[state="unsupported"],
QLabel#profileStatusLabel[state="manual"] { color: #8a4b08; }
QLabel#slicerStatusLabel[state="notFound"],
QLabel#slicerStatusLabel[state="error"],
QLabel#profileStatusLabel[state="error"] { color: #a22525; }

QLabel#statusLabel {
    font-weight: 650;
    color: #29475f;
    font-size: 9.6pt;
    padding: 5px 7px;
}
QLabel#progressStatusIcon {
    font-weight: 700;
    font-size: 10pt;
    min-width: 18px;
}
QLabel#progressStatusIcon[prominent="true"] {
    font-size: 16pt;
    min-width: 24px;
    min-height: 23px;
}
QLabel#progressStatusIcon[state="success"] { color: #176b45; }
QLabel#progressStatusIcon[state="warning"] { color: #9b6411; }
QLabel#progressStatusIcon[state="error"] { color: #b42318; }
QLabel#progressStatusIcon[state="running"] { color: #365d7a; }

QLabel#previewHintLabel[state="stale"],
QLabel#previewStateLabel[state="stale"] {
    color: #8a4b08;
    background: #fff2d6;
    border: 1px solid #dfa94f;
    border-radius: 6px;
    padding: 7px 9px;
    font-weight: 650;
}
QLabel#previewStateLabel {
    border-radius: 5px;
    padding: 5px 7px;
    font-size: 9.3pt;
}
QLabel#previewStateLabel[state="error"] { color: #b42318; font-weight: 650; }
QLabel#previewStateLabel[state="current"] { color: #176b45; font-weight: 650; }
QLabel#resultLabel { color: #176b45; font-weight: 600; }

QLabel#exportAvailabilityLabel {
    color: #405b73;
    background: transparent;
    border: none;
    padding: 2px 0;
}

QTextEdit#warningText {
    background: transparent;
    border: none;
    color: #152536;
    padding: 0;
    min-height: 0;
}

QFrame#hintPopover {
    background: #17324a;
    border: 1px solid #31536f;
    border-radius: 9px;
}

QLabel#hintPopoverText {
    color: #ffffff;
    background: transparent;
    font-size: 9.3pt;
}

/* ---------- Fortschritt ---------- */
QProgressBar {
    border: 1px solid #c5d0d8;
    border-radius: 6px;
    background: #e7edf1;
    text-align: center;
    min-height: 20px;
    color: #243b50;
}

QProgressBar::chunk { background: #1769aa; border-radius: 5px; }
QProgressBar#sourceValidationProgressBar::chunk {
    background: #26965f;
    border-radius: 5px;
}
QProgressBar#slicerDiscoveryProgressBar::chunk {
    background: #26965f;
    border-radius: 5px;
}
QProgressBar#previewProgressBar::chunk,
QProgressBar#mainProgressBar[task="preview"]::chunk {
    background: #8158c7;
    border-radius: 5px;
}

/* ---------- Vorschau und Scrollleisten ---------- */
QWidget#previewFrame {
    background: #171a20;
    border: 1px solid #667080;
    border-radius: 8px;
}

QWidget#previewInfoHeader,
QWidget#previewLegendBar,
QWidget#previewCanvas {
    background: #171a20;
    border: none;
    border-radius: 0;
}

QWidget#previewInfoHeader QLabel,
QWidget#previewLegendBar QLabel {
    background: transparent;
    border: none;
}

QLabel#previewSegmentsInfo,
QLabel#previewTowerCircleSegmentsInfo,
QLabel#previewHeightInfo,
QLabel#previewLayersInfo,
QLabel#previewBedInfo,
QLabel#previewLegendTitle {
    color: #aeb7c5;
}

QPushButton#previewCameraButton {
    min-height: 22px;
    padding: 4px 6px;
    font-size: 10.5pt;
}
QLabel#towerNeedLabel[state="smallGain"] {
    color: #8a5a00;
}

QToolButton#previewNavigationToggle {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(56, 63, 75, 225), stop: 1 rgba(27, 32, 40, 225));
    border: 1px solid #8a95a4;
    border-radius: 5px;
    padding: 5px;
}
QToolButton#previewNavigationToggle:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(78, 88, 103, 240), stop: 1 rgba(46, 54, 66, 240));
    border-color: #c4cdd8;
}
QToolButton#previewNavigationToggle[navigationEnabled="true"] {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #2f7fb7, stop: 1 #1769aa);
    border: 2px solid #8fd3ff;
}
QToolButton#previewNavigationToggle[navigationEnabled="true"]:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #3b8bc1, stop: 1 #1d75b7);
}

QToolButton#previewNavigationStatus {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(56, 63, 75, 215), stop: 1 rgba(27, 32, 40, 215));
    border: 1px solid rgba(198, 207, 218, 120);
    border-radius: 5px;
    padding: 4px 8px;
    font-size: 9pt;
    font-weight: 650;
}
QToolButton#previewNavigationStatus[state="disabled"] {
    color: #f2a39d;
}
QToolButton#previewNavigationStatus[state="enabled"] {
    color: #8fddb5;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #b8c5d1;
    border-radius: 5px;
    min-height: 36px;
}
QScrollBar::handle:vertical:hover { background: #93a6b7; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QFrame#previewActionControl[cancelAction="true"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #faeeee,
        stop: 1 #f2dada
    );
    border-color: #dfbcbc;
}

QFrame#previewActionControl[cancelAction="true"] QPushButton#previewButton {
    color: #7d4141;
    background: transparent;
    border: none;
    font-weight: 600;
}

QFrame#previewActionControl[cancelAction="true"] QPushButton#previewButton:hover {
    color: #713636;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f8e4e4,
        stop: 1 #eac5c5
    );
}

QFrame#previewActionControl[cancelAction="true"] QPushButton#previewButton:pressed {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #eacaca,
        stop: 1 #f6e7e7
    );
}

QFrame#previewActionControl[cancelAction="true"] QPushButton#previewButton:disabled {
    color: #8995a0;
    background: transparent;
}

QFrame#previewActionControl[acceptAction="true"] {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e7f8ed, stop: 1 #c7e9d3);
    border-color: #a4d5b6;
}
QFrame#previewActionControl[acceptAction="true"] QPushButton#previewButton {
    color: #20583d;
    background: transparent;
    border: none;
    font-weight: 650;
}
QFrame#previewActionControl[acceptAction="true"] QPushButton#previewButton:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #effbf3, stop: 1 #d3efdc);
}
QFrame#previewActionControl[acceptAction="true"] QPushButton#previewButton:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #bddfc9, stop: 1 #e2f6e9);
}

QPushButton#layerRangeCancelButton,
QPushButton#removeSourceButton,
QPushButton#supportSimulationCancelButton,
QPushButton#presliceCancelButton,
QPushButton#updateCancelButton,
QPushButton#updateRestartCancelButton {
    color: #7d4141;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #faeeee, stop: 1 #f2dada);
    border-color: #dfbcbc;
    font-weight: 600;
}

QPushButton#layerRangeCancelButton:hover,
QPushButton#removeSourceButton:hover,
QPushButton#supportSimulationCancelButton:hover,
QPushButton#presliceCancelButton:hover,
QPushButton#updateCancelButton:hover,
QPushButton#updateRestartCancelButton:hover {
    color: #713636;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f8e4e4, stop: 1 #eac5c5);
    border-color: #cc9d9d;
}

QPushButton#layerRangeCancelButton:pressed,
QPushButton#removeSourceButton:pressed,
QPushButton#supportSimulationCancelButton:pressed,
QPushButton#presliceCancelButton:pressed,
QPushButton#updateCancelButton:pressed,
QPushButton#updateRestartCancelButton:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #eacaca, stop: 1 #f6e7e7);
}

QPushButton#layerRangeCancelButton:disabled,
QPushButton#removeSourceButton:disabled,
QPushButton#supportSimulationCancelButton:disabled,
QPushButton#supportSimulationReloadButton:disabled,
QPushButton#supportSimulationProceedButton:disabled,
QPushButton#presliceCancelButton:disabled,
QPushButton#updateCancelButton:disabled,
QPushButton#updateRestartCancelButton:disabled {
    color: #8995a0;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f5f7f8, stop: 1 #e7ecef);
    border-color: #d8dee3;
}


QPushButton#supportSimulationReloadButton {
    color: #1769aa;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f3f9fe, stop: 1 #dcecf9);
    border-color: #bbd2e5;
    font-weight: 600;
}
QPushButton#supportSimulationReloadButton:hover {
    color: #12588f;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e8f3fb, stop: 1 #cde3f3);
    border-color: #98bbd7;
}
QPushButton#supportSimulationReloadButton:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #c8deef, stop: 1 #eaf5fc);
}
QPushButton#supportSimulationProceedButton {
    color: #23704c;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f4fbf6, stop: 1 #e0f2e7);
    border-color: #b9d8c5;
    font-weight: 600;
}
QPushButton#supportSimulationProceedButton:hover {
    color: #1b5e3f;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e9f6ee, stop: 1 #cee8d8);
    border-color: #97bfa7;
}
QPushButton#supportSimulationProceedButton:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #c7e3d2, stop: 1 #eef9f1);
}

QToolButton#previewNavigationStatus:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(78, 88, 103, 240), stop: 1 rgba(46, 54, 66, 240));
    border-color: #c4cdd8;
}

/* ---------- Gemeinsame Objekt-/Turm-Generierung ---------- */
QDialog#towerGenerationDialog,
QDialog#jointSliceSettingsDialog {
    background: #f5f8fb;
}

QFrame#generalSettingsFooterDivider {
    border: none;
    background: #c8d3df;
}

QWidget#generalSettingsFooter QPushButton {
    font-size: 10pt;
    min-height: 30px;
    max-height: 30px;
    padding: 0 12px;
}

QPushButton#generalSettingsBrowseButton {
    min-height: 34px;
    max-height: 34px;
    padding: 4px 13px;
}

QLabel#towerGenerationTitle {
    color: #152536;
    font-size: 18pt;
    font-weight: 700;
}

QLabel#towerGenerationExplanation {
    color: #526274;
    font-size: 10pt;
    padding: 0 14px 2px 14px;
}

QLabel#towerGenerationCounter {
    color: #1769aa;
    font-size: 10.5pt;
    font-weight: 650;
}

QFrame#towerGenerationSummary {
    background: #ffffff;
    border: 1px solid #d6dee8;
    border-radius: 9px;
}

QLabel#towerGenerationMetric,
QLabel#towerGenerationDeviation {
    color: #152536;
    font-weight: 700;
}

QLabel#towerGenerationDeviation[resultState="within"] {
    color: #176b45;
}

QLabel#towerGenerationDeviation[resultState="outside"] {
    color: #9b6411;
}

QFrame#towerGenerationErrorDivider {
    color: #d6dee8;
    background: #d6dee8;
    border: none;
    max-height: 1px;
}

QFrame#towerGenerationStopReasonDivider {
    color: #d6dee8;
    background: #d6dee8;
    border: none;
    max-height: 1px;
}

QLabel#towerGenerationStopReason {
    color: #72510c;
    background: #fff8df;
    border: 1px solid #e5d5a5;
    border-radius: 7px;
    padding: 9px 11px;
}

QLabel#towerGenerationStopReason[resultState="within"] {
    color: #176b45;
    background: #edf8f2;
    border-color: #a9d3ba;
}

QLabel#towerGenerationStopReason[resultState="outside"] {
    color: #72510c;
    background: #fff8df;
    border-color: #e5d5a5;
}

QLabel#towerGenerationError {
    color: #9f241b;
    background: #fff1f0;
    border: 1px solid #edc4c0;
    border-radius: 7px;
    padding: 10px 12px;
}

QPushButton#towerGenerationAcceptButton {
    color: #ffffff;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #35a66c, stop: 1 #23704c);
    border-color: #1b5e3f;
    font-weight: 650;
}
QPushButton#towerGenerationAcceptButton:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #40b477, stop: 1 #298b5a);
}
QPushButton#towerGenerationAcceptButton:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #1b5e3f, stop: 1 #2d945f);
}
QPushButton#towerGenerationAcceptButton:disabled {
    color: #eef4f0;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #a6c2b0, stop: 1 #8bac99);
    border-color: #8bac99;
}

QPushButton#towerGenerationAbortButton {
    color: #ffffff;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #d06b6b, stop: 1 #a94040);
    border-color: #963b3b;
    font-weight: 650;
}
QPushButton#towerGenerationAbortButton:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #dc7878, stop: 1 #b94e4e);
}
QPushButton#towerGenerationAbortButton:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #963b3b, stop: 1 #b94e4e);
}

QPushButton#towerGenerationContinueButton {
    color: #ffffff;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #2f7fb7, stop: 1 #1769aa);
    border-color: #12588f;
    font-weight: 650;
}
QPushButton#towerGenerationContinueButton:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #3b8bc1, stop: 1 #1d75b7);
}
QPushButton#towerGenerationContinueButton:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #12588f, stop: 1 #2b78ad);
}

/* Embedded generation: hover-only navigation chrome and compact state badge. */
QToolButton#previewNavigationStatus {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(56, 63, 75, 35), stop: 1 rgba(27, 32, 40, 15));
    border: 1px solid transparent;
}
QToolButton#previewNavigationStatus:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(56, 63, 75, 215), stop: 1 rgba(27, 32, 40, 215));
    border: 1px solid rgba(198, 207, 218, 120);
}
QWidget#generationPanel QLabel#towerGenerationTitle { font-size: 13pt; }
QLabel#generationIntroLabel {
    color: #526274;
    padding: 5px 2px 7px 2px;
}
QPushButton#generationContinueButton {
    color: #174a70;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e4f3ff, stop: 1 #c4e1f8);
    border-color: #9dc9e8;
    font-weight: 650;
}
QPushButton#generationContinueButton:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #eef8ff, stop: 1 #d1eafa);
    border-color: #78b5dc;
}
QPushButton#generationContinueButton:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #bfddf4, stop: 1 #e0f1fd);
}
QPushButton#generationContinueButton:disabled {
    color: #8995a0;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f5f7f8, stop: 1 #e7ecef);
    border-color: #d8dee3;
}
QPushButton#generationAcceptButton,
QPushButton#generationExportButton,
QPushButton#exportButton {
    color: #20583d;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e7f8ed, stop: 1 #c7e9d3);
    border-color: #a4d5b6;
    font-weight: 650;
}
QPushButton#generationAcceptButton:hover,
QPushButton#generationExportButton:hover,
QPushButton#exportButton:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #effbf3, stop: 1 #d3efdc);
    border-color: #81c59d;
}
QPushButton#generationAcceptButton:pressed,
QPushButton#generationExportButton:pressed,
QPushButton#exportButton:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #bddfc9, stop: 1 #e2f6e9);
}
QPushButton#generationAcceptButton:disabled,
QPushButton#generationExportButton:disabled,
QPushButton#exportButton:disabled {
    color: #8995a0;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f5f7f8, stop: 1 #e7ecef);
    border-color: #d8dee3;
}
QLabel#generationResultDescription {
    padding-top: 3px;
    padding-bottom: 3px;
}
QWidget#embeddedPreviewPanel QLabel#previewStateLabel {
    padding: 3px 8px;
    border-radius: 7px;
    font-size: 9pt;
}
