/* ---------- Grundlayout und Typografie ---------- */
QPushButton[rangeAction="add"] {
    background: #176b45; color: white; border: 1px solid #176b45;
    border-radius: 6px; padding: 7px 10px;
}
QPushButton[rangeAction="add"]:hover, QPushButton[rangeAction="add"]:checked {
    background: #115336;
}
QPushButton[rangeAction="remove"] {
    background: #b42318; color: white; border: 1px solid #b42318;
    border-radius: 6px; padding: 7px 10px;
}
QPushButton[rangeAction="remove"]:hover { background: #921c13; }
QPushButton[rangeAction]:disabled { background: #d6dee8; color: #637386; border-color: #d6dee8; }
QFrame#layerRangeRow { background: #fff; border: 1px solid #d6dee8; border-radius: 7px; }
QFrame#layerRangeRow[selected="true"] { background: #c6ddee; border-color: #6f9fc4; }
QWidget#layerRangeCanvas { background: #e6ecf2; border: 1px solid #9eafbf; border-radius: 6px; }
QSplitter#layerRangeSplitter::handle { background: #cbd6e1; border: none; }
QDialog#layerRangeDialog QPushButton[rangeCompact="true"] {
    min-height: 30px; max-height: 30px; padding: 0 10px;
}
QMainWindow, QDialog {
    background: #f3f6f9;
    color: #152536;
    font-family: "Segoe UI";
    font-size: 10pt;
}

QWidget {
    color: #152536;
    font-family: "Segoe UI";
    font-size: 10pt;
}

QScrollArea, QScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}

QWidget#mainHeader {
    background: #f3f6f9;
    border-bottom: 1px solid transparent;
}

QWidget#mainHeader[scrolled="true"] {
    border-bottom: 1px solid #cbd6e1;
}

QPushButton#preparationViewButton:checked,
QPushButton#preparationMethodButton:checked {
    background: #e7f1fa;
    border-color: #84abc8;
    color: #17486d;
}

QWidget#mainFooter {
    background: #f3f6f9;
    border-top: 1px solid #cbd6e1;
}

QScrollArea#footerMessagesScroll,
QScrollArea#footerMessagesScroll > QWidget > QWidget,
QWidget#footerMessagesContent,
QWidget#footerStatusContent,
QWidget#footerNoticeHost,
QWidget#footerContent,
QWidget#footerMessageArea,
QWidget#footerActionArea,
QScrollArea#footerNoticeColumn,
QScrollArea#footerNoticeColumn > QWidget > QWidget,
QWidget#footerNoticeColumnContent {
    background: transparent;
    border: none;
}

QFrame#footerVerticalDivider,
QFrame#footerHorizontalDivider {
    background: #cbd6e1;
    border: none;
}

QFrame#actionAvailabilityNotice {
    color: #714c00;
    background: transparent;
    border: none;
    border-radius: 0;
}

QLabel#actionAvailabilityIcon,
QLabel#exportAvailabilityLabel {
    color: #8a4b08;
    background: transparent;
}
QLabel#actionAvailabilityIcon[state="success"],
QLabel#exportAvailabilityLabel[state="success"] {
    color: #176b45;
}

QLabel { background: transparent; }

QLabel#titleLabel {
    font-size: 23pt;
    font-weight: 700;
    color: #153b60;
}

QLabel#subtitleLabel {
    color: #526274;
    font-size: 10.5pt;
    padding-bottom: 3px;
}

QLabel#versionLabel {
    color: #6b7c8f;
    font-size: 9pt;
    padding-bottom: 3px;
}

QPushButton#updateButton {
    color: #ffffff;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #2f7fb7, stop: 1 #1769aa);
    border: 1px solid #0f568f;
    border-radius: 5px;
    min-height: 22px;
    padding: 2px 9px;
    font-size: 9pt;
    font-weight: 600;
}

QPushButton#updateButton:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #3b8bc1, stop: 1 #1d75b7);
}
QPushButton#updateButton:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #0d4c7e, stop: 1 #246fa7);
}
QPushButton#updateButton:disabled {
    color: #dce7f0;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #7898b2, stop: 1 #5f83a3);
    border-color: #527491;
}

QLabel#sectionHeading {
    color: #153b60;
    font-size: 13pt;
    font-weight: 700;
    padding: 12px 2px 2px 2px;
}

QLabel#helpText, QLabel#calculatedHint, QLabel#predictionFootnote,
QLabel#profileFilterLabel {
    color: #5a6b7d;
    background: #f7f9fb;
    border-radius: 5px;
    padding: 5px 7px;
    font-size: 9.5pt;
}

QLabel#outputModeStatus, QLabel#profileOriginLabel,
QLabel#previewHintLabel, QLabel#previewDetailsLabel {
    color: #526274;
    border-radius: 5px;
    padding: 5px 7px;
    font-size: 9.5pt;
}

QLabel#previewQualityLabel {
    color: #34495e;
    background: #f5f8fb;
    border: 1px solid #cbd7e3;
    border-left: 4px solid #7890a8;
    border-radius: 7px;
    padding: 8px 10px;
    font-size: 9.3pt;
}
QLabel#previewQualityLabel[state="success"] {
    color: #145c3c;
    background: #edf8f2;
    border-color: #92c9ad;
    border-left-color: #23865a;
}
QLabel#previewQualityLabel[state="warning"],
QLabel#previewQualityLabel[state="stale"] {
    color: #774807;
    background: #fff7e6;
    border-color: #e0b96d;
    border-left-color: #c68517;
}
QLabel#previewQualityLabel[state="error"] {
    color: #84251f;
    background: #fff1f0;
    border-color: #e3a29d;
    border-left-color: #bd3b32;
}
QLabel#previewQualityLabel[state="building"] {
    color: #365d7a;
    background: #eef5fa;
    border-color: #adc5d7;
    border-left-color: #4e7d9f;
}

QPushButton#previewQualityDetailsToggle {
    color: #647487;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(247, 250, 252, 75), stop: 1 rgba(231, 240, 247, 45));
    border: none;
    padding: 3px 7px;
    text-align: left;
    font-size: 9.2pt;
}
QPushButton#previewQualityDetailsToggle:hover {
    color: #315d80;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f9fbfd, stop: 1 #e9f1f7);
}
QLabel#previewQualityDetailsLabel {
    color: #566779;
    background: #f7f9fb;
    border: 1px solid #d7e0e8;
    border-radius: 5px;
    padding: 7px 9px;
    font-size: 9.1pt;
}

/* ---------- Karten und aufklappbare Bereiche ---------- */
QFrame#sectionCard {
    background: #ffffff;
    border: 1px solid #d6dee8;
    border-radius: 10px;
}

QFrame#sectionCard[state="active"] {
    border-left: 4px solid #1769aa;
}

QFrame#sectionCard[state="success"] {
    background: #f8fcfa;
    border-left: 4px solid #238a5b;
}

QFrame#sectionCard[state="warning"] {
    background: #fffbf2;
    border-left: 4px solid #d38a14;
}

QFrame#sectionCard[state="error"] {
    background: #ffffff;
    border-left: 4px solid #c6372d;
}

QFrame#sectionCard[state="preview"] {
    background: #fbfaff;
    border-left: 4px solid #6f52c9;
}

QFrame#sectionCard[outerDropdown="true"] {
    border-left: 4px solid #1769aa;
}

QFrame#sectionCard[outerDropdown="true"][state="success"] {
    border-left-color: #238a5b;
}

QFrame#sectionCard[outerDropdown="true"][state="warning"] {
    border-left-color: #d38a14;
}

QFrame#sectionCard[outerDropdown="true"][state="error"] {
    border-left-color: #c6372d;
}

/* Die Vorbereitung ist bis zum letzten erfüllten Punkt ein fester Bereich.
   Die linke Kante behält intern bereits die Dropdown-Breite, wird aber erst
   nach dem Abschluss grün hervorgehoben. Dadurch kann Qt beim dynamischen
   Wechsel zum einklappbaren Header die volle Akzentbreite zuverlässig neu
   einfärben. */
QFrame#sectionCard[outerDropdown="true"][role="preparation"][collapsible="false"] {
    border-left-color: #d6dee8;
}

QFrame#sectionCard[outerDropdown="true"][role="preparation"][collapsible="false"][state="success"] {
    border-left-color: #238a5b;
}

QFrame#sectionCard[outerDropdown="true"][cardTone="preview"] {
    background: #fbfaff;
    border-left: 4px solid #6f52c9;
}

/* Hovering an outer dropdown changes only its surface colour. */
QFrame#sectionCard[outerDropdown="true"][collapsible="true"][bodyHover="true"]:hover {
    background: #f7fbfe;
}
QFrame#sectionCard[outerDropdown="true"][collapsible="true"][bodyHover="true"][state="success"]:hover {
    background: #f2faf5;
}
QFrame#sectionCard[outerDropdown="true"][collapsible="true"][bodyHover="true"][state="warning"]:hover {
    background: #fffbf2;
}
QFrame#sectionCard[outerDropdown="true"][collapsible="true"][bodyHover="true"][state="error"]:hover {
    background: #fff8f7;
}

QFrame#sectionCardHeader,
QFrame#sectionCardBody,
QWidget#sectionCardHeaderLeft {
    background: transparent;
    border: none;
}

QFrame#sectionCardHeader {
    min-height: 52px;
}

/* Nur die direkt zu einer äußersten Dropdown-Karte gehörenden Header werden
   leicht blau hinterlegt. Verschachtelte Dropdowns bleiben unverändert. */
QFrame#sectionCard[outerDropdown="true"] > QFrame#sectionCardHeader {
    background: #f0f6fb;
    border-radius: 9px;
}

QFrame#sectionCard[outerDropdown="true"][state="success"] > QFrame#sectionCardHeader {
    background: #eef8f2;
}

QFrame#sectionCard[outerDropdown="true"][role="preparation"] > QFrame#sectionCardHeader,
QFrame#sectionCard[outerDropdown="true"][role="timing"] > QFrame#sectionCardHeader,
QFrame#sectionCard[outerDropdown="true"][role="geometrySettings"] > QFrame#sectionCardHeader {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #eef7fc,
        stop: 1 #cfe3ef
    );
}

QFrame#sectionCard[outerDropdown="true"][role="preparation"] > QFrame#sectionCardBodyDivider,
QFrame#sectionCard[outerDropdown="true"][role="timing"] > QFrame#sectionCardBodyDivider,
QFrame#sectionCard[outerDropdown="true"][role="geometrySettings"] > QFrame#sectionCardBodyDivider {
    background: #9fb6c5;
    border: none;
    min-height: 1px;
    max-height: 1px;
}

QFrame#sectionCard[outerDropdown="true"][cardTone="preview"] > QFrame#sectionCardHeader {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f7f4ff,
        stop: 1 #ddd5f5
    );
}

QFrame#sectionCard[outerDropdown="true"][cardTone="preview"] > QFrame#sectionCardBodyDivider {
    background: #a99ad8;
    border: none;
    min-height: 1px;
    max-height: 1px;
}

QFrame#sectionCardBodyDivider {
    background: #e7ecf1;
    border: none;
    min-height: 1px;
    max-height: 1px;
}

QFrame#sectionCardHeader:focus {
    background: #f1f6fb;
    border: 1px solid #70a7d2;
    border-radius: 8px;
}

QFrame#sectionCard[collapsible="true"] QFrame#sectionCardHeader:hover {
    background: #f1f6fb;
}

/* Äußerste Dropdowns behalten gegenüber dem allgemeinen Header-Hover ihre
   deutlich sichtbare, zum jeweiligen Grundzustand passende Hoverfarbe. */
QFrame#sectionCard[outerDropdown="true"][collapsible="true"] > QFrame#sectionCardHeader:hover {
    background: #e5f0f8;
}

QFrame#sectionCard[outerDropdown="true"][role="preparation"][collapsible="true"] > QFrame#sectionCardHeader:hover,
QFrame#sectionCard[outerDropdown="true"][role="timing"][collapsible="true"] > QFrame#sectionCardHeader:hover,
QFrame#sectionCard[outerDropdown="true"][role="geometrySettings"][collapsible="true"] > QFrame#sectionCardHeader:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e3f1f8,
        stop: 1 #bdd9e9
    );
}

QFrame#sectionCard[outerDropdown="true"][role="preparation"][collapsible="true"] > QFrame#sectionCardHeader:pressed,
QFrame#sectionCard[outerDropdown="true"][role="timing"][collapsible="true"] > QFrame#sectionCardHeader:pressed,
QFrame#sectionCard[outerDropdown="true"][role="geometrySettings"][collapsible="true"] > QFrame#sectionCardHeader:pressed {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #d8eaf4,
        stop: 1 #aecfe1
    );
}

QFrame#sectionCard[outerDropdown="true"][collapsible="true"][state="success"] > QFrame#sectionCardHeader:hover {
    background: #e2f2e8;
}

QFrame#sectionCard[outerDropdown="true"][role="preparation"][collapsible="true"][state="success"] > QFrame#sectionCardHeader:hover,
QFrame#sectionCard[outerDropdown="true"][role="timing"][collapsible="true"][state="success"] > QFrame#sectionCardHeader:hover,
QFrame#sectionCard[outerDropdown="true"][role="geometrySettings"][collapsible="true"][state="success"] > QFrame#sectionCardHeader:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e3f1f8,
        stop: 1 #bdd9e9
    );
}

QFrame#sectionCard[collapsible="true"] QFrame#sectionCardHeader:pressed {
    background: #e5eef6;
}

QFrame#sectionCard[outerDropdown="true"][cardTone="preview"][collapsible="true"] > QFrame#sectionCardHeader:hover,
QFrame#sectionCard[outerDropdown="true"][cardTone="preview"][collapsible="true"] > QFrame#sectionCardHeader:pressed {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #eee9ff,
        stop: 1 #cec3ef
    );
}

/* Expanded headers end at a divider. Only their upper corners remain rounded,
   so neither hover nor focus paints rounded lower corners above that line. */
QFrame#sectionCard[expanded="true"] > QFrame#sectionCardHeader,
QFrame#sectionCard[expanded="true"] > QFrame#sectionCardHeader:hover,
QFrame#sectionCard[expanded="true"] > QFrame#sectionCardHeader:focus,
QFrame#sectionCard[expanded="true"] > QFrame#sectionCardHeader:pressed {
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

QLabel#sectionCardTitle {
    color: #21384f;
    font-size: 13pt;
    font-weight: 650;
}

QFrame#sectionCard[outerDropdown="true"][role="preparation"]
> QFrame#sectionCardHeader QLabel#sectionCardTitle,
QFrame#sectionCard[outerDropdown="true"][role="timing"]
> QFrame#sectionCardHeader QLabel#sectionCardTitle,
QFrame#sectionCard[outerDropdown="true"][role="geometrySettings"]
> QFrame#sectionCardHeader QLabel#sectionCardTitle {
    color: #40576a;
    font-size: 12pt;
    font-weight: 700;
}

QFrame#sectionCard[outerDropdown="true"][cardTone="preview"]
> QFrame#sectionCardHeader QLabel#sectionCardTitle {
    color: #4d3c86;
    font-size: 12pt;
    font-weight: 700;
}

QLabel#sectionCardTitleNote {
    color: #176b45;
    font-size: 9.5pt;
    font-weight: 600;
}

QLabel#sectionCardTitleNote[severity="warning"] { color: #8a4b08; }

QLabel#sectionCardSummary,
QLabel#sectionCardSummaryKey,
QLabel#sectionCardSplitSummaryLeft,
QLabel#sectionCardSplitSummaryRight {
    color: #526274;
    font-size: 9.5pt;
}

QWidget#sectionCardSplitSummary {
    background: transparent;
    border: none;
}

QLabel#sectionCardSummaryNote {
    color: #176b45;
    font-size: 9.5pt;
    font-weight: 600;
}

QLabel#sectionCardSummaryNote[severity="warning"] { color: #8a4b08; }

QLabel#sectionCardStatusIcon {
    color: #526274;
    font-size: 11pt;
    font-weight: 700;
}

QLabel#sectionCardStatusIcon[prominent="true"] {
    font-size: 18pt;
}

QLabel#sectionCardStatusIcon[headerLead="true"] {
    font-size: 25pt;
    font-weight: 750;
}

QFrame#sectionCard[state="active"] QLabel#sectionCardStatusIcon { color: #1769aa; }
QFrame#sectionCard[state="success"] QLabel#sectionCardStatusIcon { color: #176b45; }
QFrame#sectionCard[state="warning"] QLabel#sectionCardStatusIcon { color: #8a4b08; }
QFrame#sectionCard[state="error"] QLabel#sectionCardStatusIcon { color: #b42318; }
QFrame#sectionCard[state="preview"] QLabel#sectionCardStatusIcon { color: #6f52c9; }

QFrame#sectionCard QLabel#sectionCardStatusIcon[headerLead="true"] {
    color: #26965f;
}
QFrame#sectionCard[role="preparation"][preparationError="true"]
QLabel#sectionCardStatusIcon[headerLead="true"] {
    color: #b42318;
}
QLabel#sectionCardStatusIcon[state="success"] { color: #176b45; }
QFrame#sectionCard[role="gcodeSource"][state="success"] QLabel#sectionCardStatusIcon,
QFrame#sectionCard[role="slicer"][state="success"] QLabel#sectionCardStatusIcon,
QFrame#sectionCard[role="prediction"][state="success"] QLabel#sectionCardStatusIcon {
    color: #176b45;
}

QLabel#sectionCardBadge {
    background: #eef2f6;
    color: #405266;
    border: 1px solid #d6dee8;
    border-radius: 9px;
    padding: 0 8px;
    font-size: 8.5pt;
    font-weight: 650;
}

QLabel#sectionCardBadge[severity="error"] {
    background: #fff1f0;
    color: #b42318;
    border-color: #efb4af;
}

QToolButton#sectionCardToggle {
    background: transparent;
    color: #405266;
    border: none;
    padding: 0;
}

QLabel#generationMethodHeading {
    color: #153b60;
    font-size: 18pt;
    font-weight: 700;
    padding: 12px 0 4px;
}
QLabel#generationMethodLabel {
    color: #526274;
}
QPushButton[generationModeCard="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0.2, y2:1, stop:0 #ffffff, stop:1 #e9f0f7);
    border: 2px solid #cbd7e3;
    border-radius: 16px;
    padding: 0;
    text-align: left;
}
QPushButton[generationModeCard="true"]:hover {
    background: #eef6fc;
    border-color: #6f9fc4;
}
QPushButton[generationModeCard="true"]:focus {
    border: 2px solid #1769aa;
}
QPushButton[generationModeCard="true"]:pressed {
    background: #dcecf8;
    border-color: #1769aa;
}
QLabel#generationModeCardTitle {
    color: #153b60;
    font-size: 18pt;
    font-weight: 700;
}
QLabel#generationModeCardDescription {
    color: #44576c;
    font-size: 10.5pt;
}
QLabel#generationModeCardAction {
    color: #1769aa;
    background: rgba(255, 255, 255, 185);
    border: 1px solid rgba(255, 255, 255, 225);
    border-radius: 8px;
    padding: 8px 12px;
    font-weight: 600;
}
QPushButton[generationMode="automatic"] {
    background: qlineargradient(x1:0, y1:0, x2:0.2, y2:1, stop:0 #fcfaff, stop:0.45 #f0e8fb, stop:1 #d7c5ed);
    border-color: #bdabda;
}
QPushButton[generationMode="automatic"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0.2, y2:1, stop:0 #faf6ff, stop:0.45 #e9ddf8, stop:1 #cbb6e8);
    border-color: #8867b8;
}
QPushButton[generationMode="automatic"]:focus { border-color: #684394; }
QPushButton[generationMode="automatic"]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0.2, y2:1, stop:0 #e4d6f4, stop:1 #cdb6e5);
    border-color: #684394;
}
QPushButton[generationMode="automatic"] QLabel#generationModeCardTitle,
QPushButton[generationMode="automatic"] QLabel#generationModeCardAction {
    color: #563284;
}
QPushButton[generationMode="manual"] {
    background: qlineargradient(x1:0, y1:0, x2:0.2, y2:1, stop:0 #f4f9fe, stop:0.45 #e0eaf5, stop:1 #bad0e7);
    border-color: #91aecb;
}
QPushButton[generationMode="manual"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0.2, y2:1, stop:0 #eef6ff, stop:0.45 #d6e5f4, stop:1 #aac5e2);
    border-color: #527ca6;
}
QPushButton[generationMode="manual"]:focus { border-color: #274f7b; }
QPushButton[generationMode="manual"]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0.2, y2:1, stop:0 #d8e6f3, stop:1 #acbfd5);
    border-color: #274f7b;
}
QPushButton[generationMode="manual"] QLabel#generationModeCardTitle,
QPushButton[generationMode="manual"] QLabel#generationModeCardAction {
    color: #22486f;
}

QGroupBox {
    background: #ffffff;
    border: 1px solid #d6dee8;
    border-radius: 10px;
    margin-top: 15px;
    padding: 15px 14px 13px 14px;
    font-weight: 650;
    color: #21384f;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: #21384f;
}

QGroupBox#primaryCard {
    border-left: 4px solid #1769aa;
}

QGroupBox#collapsibleGroup {
    background: #ffffff;
    padding-top: 13px;
}

QGroupBox#collapsibleGroup::indicator {
    width: 0;
    height: 0;
}

QGroupBox#collapsibleGroup:hover {
    background: #fbfdff;
}

QWidget#numericSettingRow {
    background: transparent;
    border-bottom: 1px solid #e7ecf1;
}

QWidget#geometrySettingsSplit QFrame#sectionCard[subsection="single"] {
    background: #ffffff;
    border: none;
    border-radius: 8px;
}

QWidget#geometrySettingsSplit QFrame#sectionCard[subsection="single"] > QFrame#sectionCardHeader {
    background: #f5f7f9;
    border: none;
    border-radius: 0;
}

QWidget#geometrySettingsSplit QFrame#sectionCard[subsection="single"][collapsible="true"] > QFrame#sectionCardHeader {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f5f7f9, stop: 1 #e8edf2);
}
QWidget#geometrySettingsSplit QFrame#sectionCard[subsection="single"][collapsible="true"] > QFrame#sectionCardHeader:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f0f5f8, stop: 1 #dce8ef);
}
QWidget#geometrySettingsSplit QFrame#sectionCard[subsection="single"][collapsible="true"] > QFrame#sectionCardHeader:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e6eef3, stop: 1 #d3e1e9);
}

/* Die Dropdown-Titel bleiben bewusst groß. Nur die darin liegenden
   Geometrie-Unterüberschriften verwenden wieder ihre frühere Größe. */
QWidget#geometrySettingsSplit QFrame#sectionCard[subsection="single"] QLabel#sectionCardTitle,
QFrame#geometryCalculationHeader QLabel#sectionCardTitle[subsectionHeader="true"] {
    font-size: 11.5pt;
}

QWidget#geometrySettingsSplit QFrame#sectionCard[subsection="single"] > QFrame#sectionCardBody {
    background: #ffffff;
    border: none;
}

QWidget#geometrySettingsSplit QFrame#sectionCard[subsection="single"] > QFrame#sectionCardBodyDivider {
    background: #e0e5ea;
    border: none;
}

QWidget#geometrySettingsSplit QLabel#helpText,
QWidget#geometrySettingsSplit QLabel#calculatedHint {
    background: #ffffff;
    border: none;
}

QWidget#geometrySettingsSplit QLabel#settingMessage {
    background: transparent;
    border: none;
}

QWidget#geometrySettingsSplit QWidget#numericSettingRow {
    background: #ffffff;
    border: none;
}

QWidget#readyLeftColumn {
    background: transparent;
    border: none;
}

QWidget#preparationOverview,
QWidget#preparationOverviewHost,
QWidget#preparationRequirements {
    background: transparent;
    border: none;
}

QWidget#preparationProgressHeader {
    background: transparent;
    border: none;
}

QLabel#preparationProgressTitle {
    color: #294c69;
    background: transparent;
    font-size: 9.5pt;
    font-weight: 700;
}

QLabel#preparationProgressStatus {
    color: #526b7e;
    background: transparent;
    font-size: 9pt;
    font-weight: 600;
}

QLabel#preparationProgressStatus[state="complete"] {
    color: #176b45;
}

QLabel#isolatedSliceProgressDetail {
    color: #526b7e;
    background: transparent;
    font-size: 9pt;
    padding: 0 1px;
}

QProgressBar#preparationProgressBar {
    color: #294457;
    background: #dce7ed;
    border: 1px solid #abc0cd;
    border-radius: 6px;
    min-height: 18px;
    max-height: 18px;
    text-align: center;
    font-size: 8.5pt;
    font-weight: 650;
}

QProgressBar#preparationProgressBar::chunk {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #2f7fb7,
        stop: 1 #26965f
    );
    border-radius: 5px;
}

/* Ein einziger Verlauf verbindet Reiterübersicht und aktuelle Arbeitsfläche.
   Dadurch entsteht unterhalb des Dropdown-Headers keine weiße Zwischenzone. */
QFrame#sectionCard[outerDropdown="true"][role="preparation"] > QFrame#sectionCardBody {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e7f1f7,
        stop: 0.42 #f0f6f9,
        stop: 1 #f7fafc
    );
    border: none;
}

QWidget#preparationStepSelectorContainer {
    background: transparent;
    border: none;
}

QPushButton#preparationStepSelector {
    color: #40576a;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #eef7fc,
        stop: 1 #cfe3ef
    );
    border: 1px solid #76a2be;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    padding: 0;
    min-height: 48px;
    max-height: 48px;
    text-align: center;
}

QPushButton#preparationStepSelector[stepTone="source"] {
    border-color: #76a2be;
}

QPushButton#preparationStepSelector[stepTone="source"][groupHovered="true"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e3f1f8,
        stop: 1 #bdd9e9
    );
    border-color: #6198b9;
}

QPushButton#preparationStepSelector[stepTone="source"][active="true"] {
    color: #40576a;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #eef7fc,
        stop: 1 #cfe3ef
    );
    border-color: #76a2be;
}

QPushButton#preparationStepSelector[stepTone="slicer"] {
    border-color: #76a2be;
}

QPushButton#preparationStepSelector[locked="true"] {
    color: #7a8791;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #edf1f3,
        stop: 1 #dfe5e8
    );
    border-color: #aebbc3;
}

QPushButton#preparationStepSelector[locked="true"][groupHovered="true"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e9edef,
        stop: 1 #d8dfe3
    );
    border-color: #9baab4;
}

QWidget#preparationRequirements[twoColumn="false"] QPushButton#preparationStepSelector[stepTone="slicer"] {
    border: 1px solid #76a2be;
}

QWidget#preparationRequirements[twoColumn="false"] QPushButton#preparationStepSelector[stepTone="slicer"][active="true"] {
    border-left-color: #76a2be;
    border-top-color: #76a2be;
}

QPushButton#preparationStepSelector[stepTone="slicer"][groupHovered="true"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e3f1f8,
        stop: 1 #bdd9e9
    );
    border-color: #6198b9;
}

QPushButton#preparationStepSelector[stepTone="slicer"][active="true"] {
    color: #40576a;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #eef7fc,
        stop: 1 #cfe3ef
    );
    border-color: #76a2be;
}

QPushButton#preparationStepSelector[stepTone="source"][active="true"][groupHovered="true"],
QPushButton#preparationStepSelector[stepTone="slicer"][active="true"][groupHovered="true"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e3f1f8,
        stop: 1 #bdd9e9
    );
    border-color: #6198b9;
}

QPushButton#preparationStepSelector:pressed {
    padding: 0;
}

/* The two selectors are Wizard tabs, not status cards. The active tab meets
   the page below without a closing bottom edge. */
QPushButton#preparationStepSelector[active="true"] {
    color: #183a59;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f0f6fa, stop: 1 #ffffff);
    border-bottom-color: #ffffff;
}

QPushButton#preparationStepSelector[active="false"] {
    color: #5d6f7d;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #edf3f6,
        stop: 1 #dce5ea
    );
}

/* Mouse-down feedback changes only the fill; every established outline stays
   byte-for-byte governed by the state rules above. */
QPushButton#preparationStepSelector:pressed,
QPushButton#preparationStepSelector[active="true"]:pressed,
QPushButton#preparationStepSelector[active="false"]:pressed {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #cedee7,
        stop: 1 #b7ccd8
    );
}

QPushButton#preparationStepSelector[locked="true"]:pressed {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #d7dde0,
        stop: 1 #c8d0d4
    );
}

QWidget#preparationSourceRequirements,
QWidget#preparationSlicerRequirements {
    border: 1px solid #aebdc7;
    border-top: none;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

QWidget#preparationRequirements[twoColumn="true"] QWidget#preparationSourceRequirements {
    border-right: 1px solid #aebdc7;
}

QWidget#preparationSourceRequirements[active="false"],
QWidget#preparationSlicerRequirements[active="false"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e6ebee,
        stop: 0.58 #f2f5f6,
        stop: 1 #f8f9fa
    );
}

QWidget#preparationSlicerRequirements[locked="true"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e4e9ec,
        stop: 0.58 #eff2f4,
        stop: 1 #f7f8f9
    );
    border-color: #b7c1c7;
}

QLabel#preparationStepConnector {
    color: #8697a3;
    background: transparent;
    border: none;
    font-size: 14pt;
    font-weight: 750;
}

QLabel#preparationStepConnector[state="open"] {
    color: #24784f;
}

QWidget#preparationSourceRequirements[active="true"],
QWidget#preparationSlicerRequirements[active="true"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #d7eaf5,
        stop: 0.58 #edf6fa,
        stop: 1 #f7fbfd
    );
}

QWidget#preparationStepSelectorTitleRow {
    background: transparent;
