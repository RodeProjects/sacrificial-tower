        stop: 1 #1769aa
    );
    border-color: #145b91;
    font-weight: 650;
}

QPushButton#preparationBackButton:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #3b8bc1,
        stop: 1 #1d75b7
    );
    border-color: #104e7d;
}

QPushButton#preparationBackButton:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #145b91, stop: 1 #2b78ad);
}

QPushButton#preparationNextButton[ready="true"],
QPushButton#preparationFinishButton[ready="true"] {
